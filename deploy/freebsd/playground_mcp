#!/bin/sh
#
# PROVIDE: playground_mcp
# REQUIRE: NETWORKING FILESYSTEMS zfs
# KEYWORD: shutdown
#
# playground sandbox-MCP provider: Streamable-HTTP MCP on loopback, FreeBSD
# jail backend run locally on this host (`--backend jail --jail-local`).
# See deploy/freebsd/README.md for the full build/install/verify recipe.
#
# Install:
#   install -o root -g wheel -m 0555 playground_mcp /usr/local/etc/rc.d/playground_mcp
#   sysrc playground_mcp_enable=YES
#   service playground_mcp start
#
# rc.conf knobs (defaults below):
#   playground_mcp_enable  : YES to run at boot
#   playground_mcp_bind    : listen address. KEEP THIS LOOPBACK unless a
#                            TLS-terminating reverse proxy fronts the server
#                            (the daemon speaks plain HTTP; exposure is a
#                            deliberate, separate decision).
#   playground_mcp_tokens  : bearer-token store, provisioned with
#                            `playground user create --backend jail` (0600).
#   playground_mcp_binary  : path to the playground binary.
#   playground_mcp_logfile : server stdout/stderr.
#   playground_mcp_args    : extra args appended to `playground mcp-http`
#                            (e.g. --jail-dataset-parent, --idle-timeout-secs).

. /etc/rc.subr

name=playground_mcp
rcvar=playground_mcp_enable

load_rc_config $name

: ${playground_mcp_enable:="NO"}
: ${playground_mcp_bind:="127.0.0.1:8377"}
: ${playground_mcp_tokens:="/var/db/playground/tokens.json"}
: ${playground_mcp_binary:="/usr/local/bin/playground"}
: ${playground_mcp_logfile:="/var/log/playground_mcp.log"}
: ${playground_mcp_args:=""}

# Keep package binaries available to any child tooling. The root-only local
# backend itself strips its operator-facing `sudo -n` prefix before spawning.
export PATH="/usr/local/sbin:/usr/local/bin:${PATH}"

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
required_files="${playground_mcp_binary} ${playground_mcp_tokens}"
start_precmd="${name}_prestart"
command_args="-f -H -P ${pidfile} -o ${playground_mcp_logfile} -- \
    ${playground_mcp_binary} mcp-http \
    --backend jail --jail-local \
    --bind ${playground_mcp_bind} \
    --tokens ${playground_mcp_tokens} \
    ${playground_mcp_args}"

playground_mcp_prestart()
{
	# This public profile is allowed to be root only inside the dedicated
	# parent jail and only when RACCT exists. The enclosing jail cannot inspect
	# the physical host's RCTL rules; the operator must separately prove the
	# exact globally-qualified per-child rules documented in the deployment guide.
	if [ "$(/sbin/sysctl -n security.jail.jailed 2>/dev/null)" != 1 ]; then
		echo "playground_mcp refuses to run outside its dedicated parent jail" >&2
		return 1
	fi
	securelevel=$(/sbin/sysctl -n kern.securelevel 2>/dev/null) || return 1
	if [ "${securelevel}" -lt 1 ]; then
		echo "playground_mcp requires kern.securelevel >= 1" >&2
		return 1
	fi
	if [ "$(/sbin/sysctl -n kern.racct.enable 2>/dev/null)" != 1 ]; then
		echo "playground_mcp requires RACCT/RCTL (kern.racct.enable=1)" >&2
		return 1
	fi
	# The provider must enumerate and unmount its own single-file nullfs mounts.
	# A nested jail with enforce_statfs=1 redacts those entries (including FSID),
	# making safe teardown impossible even though mount(8) can create them.
	if [ "$(/sbin/sysctl -n security.jail.enforce_statfs 2>/dev/null)" != 0 ]; then
		echo "playground_mcp requires the trusted parent jail to use enforce_statfs=0" >&2
		return 1
	fi

	# The process holds bearer/OAuth material in memory. Make the inherited
	# core limit explicit and ensure daemon-created logs are private.
	umask 077
	ulimit -c 0
	/usr/bin/touch "${playground_mcp_logfile}"
	/bin/chmod 0600 "${playground_mcp_logfile}"
}

run_rc_command "$1"
