# The public IPv4 HAProxy sends PROXY protocol on its dedicated TLS backend
# port. Decode it before the TLS handshake and trust client addresses only
# when they came from the two production gateways. Direct public IPv6 remains
# on the ordinary :443 listener and never passes through this wrapper.
#
# Site-specific addresses are environment placeholders, so this file is
# publishable as-is and the deployment supplies its own topology:
#
#   PLAYGROUND_LAN_IP     address this jail's Caddy binds for the IPv4 path
#   PLAYGROUND_PROXY_GW1  first gateway allowed to assert a client address
#   PLAYGROUND_PROXY_GW2  second gateway allowed to assert a client address
#
# Each defaults to 127.0.0.1. The default is deliberately narrower than any
# real deployment: forgetting to set these yields a listener that answers
# nobody, never one that trusts more peers than intended.
{
	servers {$PLAYGROUND_LAN_IP:127.0.0.1}:444 {
		listener_wrappers {
			proxy_protocol {
				timeout 2s
				allow {$PLAYGROUND_PROXY_GW1:127.0.0.1}/32 {$PLAYGROUND_PROXY_GW2:127.0.0.1}/32
				fallback_policy skip
			}
			tls
		}

		# HAProxy accepts public TCP :443, so this internal listener must not
		# advertise its backend-only :444 as an HTTP/3 endpoint.
		protocols h1 h2
	}
}

# The playground has one public origin. Both ingress listeners terminate TLS
# in Caddy and forward every MCP and OAuth route to the provider's
# loopback-only listener. There is intentionally no <jail-host> site until
# an actual UI exists.
(playground_routes) {
	reverse_proxy 127.0.0.1:8377

	# Caddy's file writer rotates this log itself. Authorization headers are not
	# included in the default access-log fields.
	log playground {
		output file /var/log/caddy/playground_access.log {
			mode 0600
			roll_size 10MiB
			roll_keep 7
			roll_keep_for 168h
		}
		format json
	}
}

mcp.bultmann.eu {
	import playground_routes
}

# LAN-only backend for the shared IPv4 HAProxy VIP. The PROXY listener wrapper
# above consumes the preamble before Caddy begins the TLS handshake.
https://mcp.bultmann.eu:444 {
	bind {$PLAYGROUND_LAN_IP:127.0.0.1}
	import playground_routes
}
